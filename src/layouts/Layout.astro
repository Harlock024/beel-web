---
import "@/styles/globals.css";

const {title = "Beel"} = Astro.props;
---
<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <title>{title}</title>
    </head>
    <body class="flex m-0 min-h-screen min-w-max">
        <slot />
    </body>
</html>
