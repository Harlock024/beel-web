---
import { SidebarTask } from "./sidebarTask";
import { SidebarList } from "./sidebarList";
import { SidebarTags } from "./sidebarTags";
import { Button } from "../ui/button";
import { Ghost, LogInIcon, Settings } from "lucide-react";
---

<aside
    class="border border-gray-200 rounded-lg shadow-md bg-gray-50 w-60 h-screen flex flex-col p-4"
>
    <h1
        class="text-2xl font-bold text-gray-800 mb-6 pb-2 border-b border-gray-200"
    >
        Beel
    </h1>

    <section class="mb-4">
        <SidebarTask className="text-gray-700" />
    </section>

    <section class="mb-4">
        <SidebarList client:load className="text-gray-700" />
    </section>

    <section class="mb-4">
        <SidebarTags client:load className="text-gray-700" />
    </section>

    <section class="mt-auto pt-4 border-t border-gray-200">
        <button
            class="flex justify-start items-center gap-2 px-3 py-2 text-gray-600 hover:bg-gray-200 rounded-md transition-colors w-full"
        >
            <Settings className="w-5" />
            Ajustes
        </button>
    </section>
</aside>
